# Copy to .env.local and fill in real values. Never commit .env.local.
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional — welcome/password-reset mail is skipped when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@creathive.app
NEXTAUTH_URL=http://localhost:3000

# Supabase — publishable key only. Service-role keys must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# local | supabase — flip to supabase only after applying supabase/schema.sql
NEXT_PUBLIC_DATA_SOURCE=local

# Copy to .env.local and fill in real values. Never commit .env.local.
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Brevo REST API by default (HTTPS works on Vercel; SMTP ports do not).
# The API key must have "Transactional emails" / send permission enabled.
# EMAIL_TRANSPORT=smtp is only for non-Vercel runtimes and needs the xsmtpsib-* key.
EMAIL_TRANSPORT=brevo
# Public HTTPS URL for the wordmark in emails (relative/data URLs don't render)
EMAIL_LOGO_URL=
BREVO_API_KEY=
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=creathivee@gmail.com
SMTP_FROM_NAME=Hiver of CreatHive

# Supabase Auth "Send Email" hook secret (from Authentication → Hooks → Send Email)
# Format: v1,whsec_<base64>. Keep server-side only; also set it in Vercel.
SEND_EMAIL_HOOK_SECRET=

# Site URL used in email links and social metadata
NEXT_PUBLIC_SITE_URL=https://creathivee.vercel.app
NEXTAUTH_URL=https://creathivee.vercel.app

# Supabase — publishable key only. Service-role keys must stay server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# local | supabase — flip to supabase only after applying supabase/schema.sql
NEXT_PUBLIC_DATA_SOURCE=local

# Web Push (free, VAPID — no paid service). Generate a pair with:
#   npx web-push generate-vapid-keys
# The public key must also be exposed to the browser; the private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:creathivee@gmail.com
# Server-only. Required to read recipients' subscriptions and claim one-shot guards.
# Never commit this — RLS is bypassed with this key.
SUPABASE_SERVICE_ROLE_KEY=
